export const getFamily = (id) => SERVICE_FAMILIES.find((f) => f.id === id);
export const familyNav = (id) => {
  const i = SERVICE_FAMILIES.findIndex((f) => f.id === id);
  return {
    prev: SERVICE_FAMILIES[(i - 1 + SERVICE_FAMILIES.length) % SERVICE_FAMILIES.length],
    next: SERVICE_FAMILIES[(i + 1) % SERVICE_FAMILIES.length],
    index: i,
  };
};

